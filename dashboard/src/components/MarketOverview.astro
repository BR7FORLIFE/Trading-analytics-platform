---
import CalendarIcon from "../assets/calendar.svg";
import ArrowDownIcon from "../assets/arrow-down.svg"
---

<section class="w-full px-8 py-8">
  <div class="flex items-end justify-between">
    <div class="flex flex-col gap-1">
      <div class="flex items-center gap-2">
        <span class="h-2 w-2 rounded-full bg-gray-900"></span>

        <span
          class="text-xs font-medium uppercase tracking-[0.16em] text-gray-600"
        >
          Live Market Overview
        </span>
      </div>

      <h1 class="mt-2 text-4xl font-bold tracking-tight text-gray-950">
        Market overview
      </h1>

      <p class="text-base text-gray-500">
        Track economic indicators and identify market momentum.
      </p>
    </div>

    <button
      type="button"
      class="flex h-12 items-center gap-3 rounded-xl border border-gray-200 bg-gray-50 px-4 text-sm font-medium text-gray-800 transition-colors hover:bg-gray-100"
    >
      <CalendarIcon />
      <span> Jun 10 — Jun 14, 2024 </span>
     <ArrowDownIcon />
    </button>
  </div>

  <div class="mt-8 grid grid-cols-4 gap-4">
    <article class="rounded-2xl border border-gray-200 bg-white p-5">
      <span class="text-xs font-semibold uppercase tracking-wide text-gray-500">
        Market Sentiment
      </span>

      <div class="mt-6 flex items-center justify-between">
        <span class="text-3xl font-bold tracking-tight text-gray-950">
          Bullish
        </span>

        <span
          class="rounded-full bg-gray-100 px-3 py-1 text-xs font-semibold text-gray-700"
        >
          +68%
        </span>
      </div>

      <div class="mt-5 h-1.5 w-full overflow-hidden rounded-full bg-gray-100">
        <div class="h-full w-[68%] rounded-full bg-gray-900"></div>
      </div>
    </article>

    <article class="rounded-2xl border border-gray-200 bg-white p-5">
      <span class="text-xs font-semibold uppercase tracking-wide text-gray-500">
        Advancers / Decliners
      </span>

      <div class="mt-6">
        <span class="text-3xl font-bold tracking-tight text-gray-950">
          64 / 31
        </span>

        <p class="mt-1 text-sm text-gray-700">
          <span class="font-medium">+33</span>
          net advancing
        </p>
      </div>
    </article>

    <article class="rounded-2xl border border-gray-200 bg-white p-5">
      <span class="text-xs font-semibold uppercase tracking-wide text-gray-500">
        Avg. Daily Move
      </span>

      <div class="mt-6">
        <span class="text-3xl font-bold tracking-tight text-gray-950">
          +0.42%
        </span>

        <p class="mt-1 text-sm text-gray-600">
          <span class="font-medium text-gray-900"> ↑ 0.18% </span>
          vs prior week
        </p>
      </div>
    </article>

    <article class="rounded-2xl border border-gray-200 bg-white p-5">
      <span class="text-xs font-semibold uppercase tracking-wide text-gray-500">
        Volatility Regime
      </span>

      <div class="mt-6">
        <span class="text-3xl font-bold tracking-tight text-gray-950">
          Low
        </span>

        <p class="mt-1 text-sm text-gray-500">
          VIX at
          <span class="font-medium text-gray-700"> 17.03 </span>
        </p>
      </div>
    </article>
  </div>
</section>
